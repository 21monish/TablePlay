APP_NAME=TablePlay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Optional explicit paths for validating signed APKs from Apache/XAMPP.
TABLEPLAY_ANDROID_SDK=
TABLEPLAY_JAVA=
TABLEPLAY_CLOUD_CONSOLE=false
TABLEPLAY_REQUIRE_EMAIL_VERIFICATION=false
TABLEPLAY_SUPERADMIN_NAME="TablePlay Super Admin"
TABLEPLAY_SUPERADMIN_EMAIL=
TABLEPLAY_SUPERADMIN_PASSWORD=
TABLEPLAY_OFFLINE_REQUEST_TTL_DAYS=30
TABLEPLAY_OFFLINE_LICENSE_LEASE_DAYS=30

BROADCAST_CONNECTION=log
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=0
REVERB_PUBLIC_SCHEME=
FILESYSTEM_DISK=local
TABLEPLAY_MEDIA_DRIVER=local
TABLEPLAY_UPDATES_DRIVER=local
TABLEPLAY_MEDIA_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=local
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_MEDIA_BUCKET=tableplay-media
SUPABASE_UPDATES_BUCKET=tableplay-updates
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
